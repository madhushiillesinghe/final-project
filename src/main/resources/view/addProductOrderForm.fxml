<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<AnchorPane prefHeight="350.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.project.controller.addOrderProductController">
   <children>
      <ImageView fitHeight="350.0" fitWidth="600.0">
         <image>
            <Image url="@../icon/add%20customer%20(1).png" />
         </image>
      </ImageView>
      <Text layoutX="80.0" layoutY="33.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Add Product Order">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Text>
      <ImageView fitHeight="20.0" fitWidth="20.0" layoutX="53.0" layoutY="16.0">
         <image>
            <Image url="@../icon/receipt-item%203.png" />
         </image>
      </ImageView>
      <ComboBox fx:id="comboxproductid" layoutX="216.0" layoutY="97.0" prefWidth="150.0" style="-fx-background-color: #ACE1AF;" />
      <ComboBox fx:id="comboxcustomerid" layoutX="216.0" layoutY="143.0" prefWidth="150.0" style="-fx-background-color: #ACE1AF;" />
      <TextField fx:id="txtqtyofbuy" layoutX="218.0" layoutY="186.0" prefHeight="24.0" prefWidth="82.0" style="-fx-background-color: #ACE1AF;" />
      <Text layoutX="110.0" layoutY="113.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Product id:" />
      <Text layoutX="110.0" layoutY="160.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Customer id:" />
      <Text layoutX="110.0" layoutY="203.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Quantity of buy:" />
      <Button fx:id="btncancel" layoutX="371.0" layoutY="297.0" mnemonicParsing="false" onAction="#cancelbtnonaction" style="-fx-background-color: #ffffff;" text="CANCEL" textFill="#0b7923" />
      <Button fx:id="btnadd" layoutX="455.0" layoutY="297.0" mnemonicParsing="false" onAction="#addbtnonaction" style="-fx-background-color: #0B7923;" text="ADD" textFill="#ebd6d6">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
