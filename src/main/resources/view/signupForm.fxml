<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.project.controller.SignupController">
   <children>
      <ImageView fitHeight="550.0" fitWidth="1000.0">
         <image>
            <Image url="@../icon/Sign%20up.png" />
         </image>
      </ImageView>
      <Button fx:id="btnsignup" layoutX="326.0" layoutY="431.0" mnemonicParsing="false" onAction="#signuponaction" style="-fx-background-color: #339900;" text="SIGN UP" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <TextField fx:id="txtemail" layoutX="280.0" layoutY="220.0" prefHeight="32.0" prefWidth="171.0" promptText="     Enter your email" style="-fx-background-color: #ffffff;" />
      <TextField fx:id="txtusername" layoutX="280.0" layoutY="266.0" prefHeight="32.0" prefWidth="171.0" promptText="          usename" style="-fx-background-color: #ffffff;" />
      <PasswordField fx:id="pwfpassword" layoutX="280.0" layoutY="314.0" prefHeight="32.0" prefWidth="171.0" promptText="          password" />
      <PasswordField fx:id="psfconfirmpassword" layoutX="280.0" layoutY="365.0" prefHeight="32.0" prefWidth="171.0" promptText="    confirm password" />
   </children>
</AnchorPane>
