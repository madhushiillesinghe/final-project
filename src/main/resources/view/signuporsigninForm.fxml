<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="550.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.project.controller.sign_upORsign_inController">
   <children>
      <ImageView fitHeight="550.0" fitWidth="1000.0">
         <image>
            <Image url="@../icon/sign%20in.png" />
         </image>
      </ImageView>
      <Button fx:id="btnsignin" layoutX="346.0" layoutY="329.0" mnemonicParsing="false" onAction="#signinonaction" prefHeight="31.0" prefWidth="99.0" style="-fx-background-color: #339900;" text="SIGN IN" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button fx:id="btnsignup" layoutX="565.0" layoutY="329.0" mnemonicParsing="false" onAction="#signuponaction" prefHeight="31.0" prefWidth="99.0" style="-fx-background-color: #339900;" text="SIGN UP" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
